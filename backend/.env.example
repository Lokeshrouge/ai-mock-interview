NODE_ENV=development
PORT=3001

# Database - CRITICAL: Use PostgreSQL in production
# Local dev: sqlite:./mock_interview.db or postgresql://localhost:5432/mock_interview
# Production: postgresql://user:pass@host:5432/dbname
DATABASE_URL=postgresql://dev:dev_password@localhost:5432/mock_interview

# Authentication - CRITICAL: Generate secure 64-char secret for production
JWT_SECRET=super_secret_jwt_key_mock_interview_development_only
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# AI Service Integration
AI_SERVICE_URL=http://localhost:8000

# File Upload Configuration
FILE_UPLOAD_MAX_SIZE=5242880
UPLOAD_STORAGE_TYPE=local  # Options: 'local', 's3', 'cloudinary'

# AWS S3 Configuration (required if UPLOAD_STORAGE_TYPE=s3)
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_REGION=us-east-1
AWS_S3_BUCKET=mock-interview-resumes

# Cloudinary Configuration (required if UPLOAD_STORAGE_TYPE=cloudinary)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# CORS - CRITICAL: Set to production domain in production
CORS_ORIGIN=http://localhost:3000
