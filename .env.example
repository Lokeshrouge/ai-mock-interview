# ==============================================================================
# AI Mock Interview Platform - Environment Configuration Example
# ==============================================================================

# Database (PostgreSQL)
POSTGRES_DB=mock_interview
POSTGRES_USER=dev
POSTGRES_PASSWORD=dev_password
POSTGRES_PORT=5432
DATABASE_URL=postgresql://dev:dev_password@localhost:5432/mock_interview

# Backend Service (NestJS)
NODE_ENV=development
PORT=3001
JWT_SECRET=super_secret_jwt_key_mock_interview_development_only
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d
AI_SERVICE_URL=http://localhost:8000
FILE_UPLOAD_MAX_SIZE=5242880
CORS_ORIGIN=http://localhost:3000

# AI Service (FastAPI)
AI_SERVICE_PORT=8000
AI_PROVIDER=openai
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
MODEL_NAME=gpt-4-turbo
TEMPERATURE=0.7
MAX_TOKENS=2000

# Frontend (Next.js)
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_APP_NAME="AI Mock Interview"
