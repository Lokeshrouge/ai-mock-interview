# AI Mock Interview - Production Environment Variables Template
# Copy this file and fill in the values after creating services

# ============================================
# BACKEND SERVICE (Render)
# ============================================

NODE_ENV=production
PORT=3001

# Database - Get from Render PostgreSQL "Internal Database URL"
DATABASE_URL=postgresql://user:password@hostname:5432/dbname

# Authentication - Generate with: openssl rand -base64 48
JWT_SECRET=REPLACE_WITH_GENERATED_SECRET
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# AI Service - Get from Render AI Service URL
AI_SERVICE_URL=https://mock-interview-ai-service-xxxx.onrender.com

# File Upload
FILE_UPLOAD_MAX_SIZE=5242880
UPLOAD_STORAGE_TYPE=cloudinary

# Cloudinary - Get from https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=123456789012345
CLOUDINARY_API_SECRET=abcdefghijklmnopqrstuvwxyz

# CORS - Update after deploying frontend
CORS_ORIGIN=https://your-app.vercel.app

# ============================================
# AI SERVICE (Render)
# ============================================

# LLM Provider - anthropic or openai
LLM_PROVIDER=anthropic

# Anthropic - Get from https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-xxxxx

# Alternative: OpenAI - Get from https://platform.openai.com
# OPENAI_API_KEY=sk-xxxxx

# Service Config
ALLOWED_ORIGINS=*
MAX_WORKERS=4
LOG_LEVEL=INFO

# ============================================
# FRONTEND (Vercel)
# ============================================

# Backend API - Get from Render Backend Service URL
NEXT_PUBLIC_API_URL=https://mock-interview-backend-xxxx.onrender.com

# Environment
NEXT_PUBLIC_ENV=production

# ============================================
# SETUP CHECKLIST
# ============================================

# 1. Create Cloudinary account: https://cloudinary.com
#    - Copy Cloud Name, API Key, API Secret
#
# 2. Get Anthropic API key: https://console.anthropic.com
#    - Create API key
#
# 3. Deploy to Render: https://render.com/new
#    - Use render.yaml blueprint or create manually
#    - Copy database URL, backend URL, AI service URL
#
# 4. Generate JWT Secret:
#    openssl rand -base64 48
#
# 5. Deploy Frontend to Vercel: https://vercel.com/new
#    - Import GitHub repository
#    - Set NEXT_PUBLIC_API_URL
#
# 6. Update CORS_ORIGIN in backend with Vercel URL
#
# 7. Test deployment with deploy-cli.ps1

# ============================================
# SECURITY NOTES
# ============================================

# - NEVER commit this file with real values
# - Keep in password manager or secrets vault
# - Rotate JWT_SECRET periodically
# - Rotate API keys if exposed
# - Use environment-specific secrets
